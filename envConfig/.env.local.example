# 小米账号配置 - 用于本地调试
# 
# 使用步骤：
# 1. 复制此文件为 .env.local
# 2. 填入你的实际信息
# 3. 运行调试脚本即可
#
# 注意：.env.local 包含敏感信息，不要提交到 Git！

# ============ 小米账号 ============

# 小米账号 ID（数字形式）
# 获取方式：https://account.xiaomi.com -> 查看账号设置 -> 复制 MiID
MI_USER_ID=123456789

# 小米账号密码
# 仅当使用用户名密码登录时需要
MI_PASSWORD=your_password

# 或使用 PassToken（推荐，更安全）
# 获取方式：使用小米官方 App 登录后，通过浏览器 DevTools 查看请求中的 serviceToken
# 如果提供了 MI_PASS_TOKEN，MI_PASSWORD 将被忽略
MI_PASS_TOKEN=

# ============ 设备配置 ============

# 小爱音箱设备名称
# 必须与米家 App 中的设备名称完全相同
MI_DEVICE_NAME=客厅音箱

# ============ 调试选项 ============

# 是否启用调试模式（输出详细日志）
MI_DEBUG=true

# 网络请求超时时长（毫秒）
# 如网络较慢，可增大此值
MI_TIMEOUT=5000

# 音箱控制方式
# mina  - 使用 MiNA 协议（推荐，针对音箱优化）
# miot  - 使用 MIoT 协议（通用设备控制）
MI_SPEAKER_CONTROL=mina

# ============ 可选配置 ============

# 启动时是否播报上线提示
MI_ANNOUNCE_ON_START=false

# 启动播报文案
MI_STARTUP_MESSAGE=小龙虾已上线

# 是否在收到消息时回复"收到"
MI_ACKNOWLEDGE_ON_RECEIVE=false

# 收到消息的回复文案
MI_RECEIVE_MESSAGE=收到，处理中
